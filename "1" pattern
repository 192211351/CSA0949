import java.util.Scanner;
public class pattern {
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int i,j;
		System.out.println("enter the number:");
		int n=sc.nextInt();
		for(i=1;i<=n;i++)
		{
			for(j=0;j<i;j++)
			{
				System.out.print("1");
			}
			System.out.println();
		}
		for(i=n-1;i>=1;i--)
		{
			for(j=0;j<i;j++)
			{
				System.out.print("1");
			}
			System.out.println();
		}
		sc.close();
		
	}
}
