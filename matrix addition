import java.util.Scanner;
public class matrixaddition{
	public static void main(String[] args)
	{
		Scanner sc=new Scanner(System.in);
		int i,j,k;
		System.out.println("enter the no.of rows in the first matrix:");
		int r1=sc.nextInt();
		System.out.println("enter the no.of columns in the first matrix:");
		int c1=sc.nextInt();
		System.out.println("enter the no.of rows in the second matrix:");
		int r2=sc.nextInt();
		System.out.println("enter the no.of colmns in the second matrix:");
		int c2=sc.nextInt();
		if(r1==r2 && c1==c2)
		{
			int m1[][]=new int[r1][c1];
			int m2[][]=new int[r2][c2];
			int resultmatrix[][]=new int[r2][c2];
			System.out.println("enter the elements in the first matrix:");
			for(i=0;i<r1;i++) {
				for(j=0;j<c1;j++) {
					m1[i][j]=sc.nextInt();
				}
			}
			System.out.println("enter the elements in the second matrix:");
			for(i=0;i<r2;i++) {
				for(j=0;j<c2;j++) {
					m2[i][j]=sc.nextInt();
				}
			}
			for(i=0;i<r1;i++) {
				for(j=0;j<c2;j++) {
						resultmatrix[i][j]=m1[i][j]+m2[i][j];	
				}
			}
			System.out.println("result matrix:");
			for(i=0;i<r1;i++) {
				for(j=0;j<c2;j++)
				{
					System.out.println(resultmatrix[i][j]);
				}
			}
			}
		else
		{
			System.out.println("addition not possible");
		}
		sc.close();
	}
}
