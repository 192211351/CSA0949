public class alphabetic_order {
	public static void main(String[] args) {
		int n=4;
		int i,j;
		String temp;
		String[] name= {"carrot","radish","Banana","Apple","Jack"};
		for(i=0;i<n;i++)
		{
			for(j=i+1;j<n;j++)
			{
				if(name[i].compareTo(name[j])>0)
				{
					temp=name[i];
					name[i]=name[j];
					name[j]=temp;
				}
				}
			}
		System.out.println("alphabetic order:");
		for(i=0;i<n;i++)
		{
			System.out.println(name[i]);
		}
}

}
OUTPUT:
alphabetic order:
Apple
Banana
carrot
radish
